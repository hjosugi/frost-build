#!/bin/sh
# frostw — run the frost release this repository declares.
#
# Check this file in next to `.frost-version`, the way gradlew and bazelisk
# are checked in. Building the repository then reads `./frostw build` on every
# machine, and "first install frost X.Y.Z" disappears from the README.
#
# Resolution order:
#   1. a `frost` on PATH that already reports the declared version
#   2. a copy downloaded earlier, under $FROST_HOME/versions/<version>
#   3. that version's GitHub release, verified against SHA256SUMS before it is
#      unpacked
#
# The wrapper never updates itself and never resolves a range: `.frost-version`
# names one exact version, because the point of checking it in is that two
# machines run the same build.

set -eu

self=${0##*/}

say() {
    printf '%s: %s\n' "$self" "$1" >&2
}

# Exit 2 throughout: every failure here is "frost could not be run as asked",
# which is what docs/28_compatibility_contract.md gives that code to.
die() {
    say "$1"
    exit 2
}

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) ||
    die "cannot resolve the directory holding $self"

version_file="$here/.frost-version"
[ -f "$version_file" ] || die "no $version_file. write one line naming the frost version this workspace requires, for example 0.9.0"

# One line, no decoration. Blank lines and `#` comments are skipped so the file
# can carry a note about why the version is pinned.
version=$(
    sed -e 's/#.*//' -e 's/[[:space:]]//g' "$version_file" |
        while IFS= read -r line; do
            if [ -n "$line" ]; then
                printf '%s' "$line"
                break
            fi
        done
)

case "$version" in
'') die "$version_file names no version" ;;
esac
printf '%s' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' ||
    die "$version_file names '$version', which is not an X.Y.Z version"

frost_home=${FROST_HOME:-$HOME/.frost}
install_dir="$frost_home/versions/$version"
binary="$install_dir/frost"

# What a reader can do by hand when the automatic path cannot finish. Printed
# by every failure below, because "download failed" without this is a dead end.
manual_recovery() {
    say "to continue without this download, either:"
    say "  * install frost $version and put it on PATH, or"
    say "  * unpack that release yourself so that $binary exists"
}

# A matching frost already on PATH is the answer: no download, no cache, and a
# developer who installed frost themselves is not second-guessed.
if command -v frost >/dev/null 2>&1; then
    on_path=$(frost --version 2>/dev/null | awk 'NR == 1 { print $NF }' || true)
    if [ "$on_path" = "$version" ]; then
        exec frost "$@"
    fi
fi

[ -x "$binary" ] && exec "$binary" "$@"

# Only the triples the release workflow actually builds. Guessing a name that
# has no asset would turn a clear "no release for this host" into a 404.
case "$(uname -s)/$(uname -m)" in
Linux/x86_64 | Linux/amd64) triple=x86_64-unknown-linux-musl ;;
Darwin/arm64 | Darwin/aarch64) triple=aarch64-apple-darwin ;;
Darwin/x86_64) triple=x86_64-apple-darwin ;;
*)
    say "no published frost release for $(uname -s) $(uname -m)"
    say "releases cover x86_64 Linux, and Apple silicon and x86_64 macOS"
    manual_recovery
    exit 2
    ;;
esac

archive="frostbuild-v$version-$triple.tar.gz"
base_url=${FROSTW_RELEASE_BASE_URL:-https://github.com/hjosugi/frost-build/releases/download}
release_url="$base_url/v$version"

if command -v curl >/dev/null 2>&1; then
    fetch() { curl --fail --location --silent --show-error --output "$2" -- "$1"; }
elif command -v wget >/dev/null 2>&1; then
    fetch() { wget --quiet --output-document "$2" -- "$1"; }
else
    say "neither curl nor wget is available, so frost $version cannot be downloaded"
    manual_recovery
    exit 2
fi

if command -v sha256sum >/dev/null 2>&1; then
    sha256_of() { sha256sum "$1" | cut -d' ' -f1; }
elif command -v shasum >/dev/null 2>&1; then
    sha256_of() { shasum -a 256 "$1" | cut -d' ' -f1; }
else
    say "neither sha256sum nor shasum is available, and an unverified download will not be used"
    manual_recovery
    exit 2
fi

mkdir -p "$frost_home/versions"
# Staged inside the destination's own directory so the final move is a rename
# on one filesystem: either the whole version appears, or none of it does.
staging=$(mktemp -d "$frost_home/versions/.frostw-XXXXXX") ||
    die "cannot create a staging directory under $frost_home/versions"
# shellcheck disable=SC2064  # $staging is fixed now; expanding later is wrong.
trap "rm -rf '$staging'" EXIT INT TERM

say "downloading frost $version ($triple)"

if ! fetch "$release_url/SHA256SUMS" "$staging/SHA256SUMS"; then
    say "cannot fetch $release_url/SHA256SUMS"
    say "either $version is not a published release, or the network is unavailable"
    manual_recovery
    exit 2
fi

expected=$(awk -v want="$archive" '
    { name = $2; sub(/^[*]/, "", name) }
    name == want { print $1; exit }
' "$staging/SHA256SUMS")
[ -n "$expected" ] || {
    say "release $version publishes no $archive"
    manual_recovery
    exit 2
}

if ! fetch "$release_url/$archive" "$staging/$archive"; then
    say "cannot fetch $release_url/$archive"
    manual_recovery
    exit 2
fi

actual=$(sha256_of "$staging/$archive")
if [ "$actual" != "$expected" ]; then
    say "checksum mismatch for $archive"
    say "  expected $expected"
    say "  got      $actual"
    say "the download was discarded and nothing was installed"
    manual_recovery
    exit 2
fi

# Unpacked only after the checksum matched, and only into the staging
# directory, so a rejected or truncated archive leaves no half-installed
# version behind for the next run to trust.
tar -xzf "$staging/$archive" -C "$staging" ||
    die "cannot unpack $archive"

unpacked="$staging/frostbuild-v$version-$triple"
[ -x "$unpacked/frost" ] ||
    die "$archive does not contain frostbuild-v$version-$triple/frost"

# A concurrent frostw may have installed the same version first. It unpacked
# the same verified bytes, so losing that race is success.
if ! mv "$unpacked" "$install_dir" 2>/dev/null; then
    [ -x "$binary" ] || die "cannot install frost $version into $install_dir"
fi

rm -rf "$staging"
trap - EXIT INT TERM

exec "$binary" "$@"
