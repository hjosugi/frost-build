# FrostBuild generated state
.frost/
.frost-bench/
bench/results/
sample_c/gen/
sample_multi/gen/

# Ecosystem build state in the wrapped-tool samples. Their output trees
# (sample_spring/build/, sample_maven/target/) are already covered by the
# generic build/ and target/ rules below.
.gradle/

# Rust build artifacts
target/

# VS Code extension build state. `out/` is the compiled extension; the generic
# build/ and dist/ rules below do not cover it.
node_modules/
tools/vscode/out/

# Bazel output trees and workspace symlinks
bazel-*/
bazel-bin/
bazel-out/
bazel-testlogs/
bazel_out/

# Zig build outputs
.zig-cache/
zig-cache/
zig-out/

# Python caches and packaging
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Local configuration and secrets
.env
.env.*
!.env.example

# Logs and temporary files
*.log
*.tmp
*.swp
*~

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Generated local knowledge graph
/graphify-out/
